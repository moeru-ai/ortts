  {"cat": "ja_hiragana", "lang": "ja", "text": "おなかがすいた。"},
  {"cat": "ja_hiragana", "lang": "ja", "text": "ねむい。"},
  {"cat": "ja_hiragana", "lang": "ja", "text": "まってください。"},
