  {"cat": "ja_hiragana", "lang": "ja", "text": "さしすせそ、たちつてと、なにぬねの。"},
  {"cat": "ja_hiragana", "lang": "ja", "text": "はひふへほ、まみむめも、やゆよ。"},
  {"cat": "ja_hiragana", "lang": "ja", "text": "らりるれろ、わをん。"},
  {"cat": "ja_hiragana", "lang": "ja", "text": "がぎぐげご、ざじずぜぞ、だぢづでど。"},
  {"cat": "ja_hiragana", "lang": "ja", "text": "ばびぶべぼ、ぱぴぷぺぽ。"},
  {"cat": "ja_hiragana", "lang": "ja", "text": "きゃきゅきょ、しゃしゅしょ、ちゃちゅちょ。"},
  {"cat": "ja_hiragana", "lang": "ja", "text": "にゃにゅにょ、ひゃひゅひょ、みゃみゅみょ、りゃりゅりょ。"},
  {"cat": "ja_hiragana", "lang": "ja", "text": "ぎゃぎゅぎょ、じゃじゅじょ、びゃびゅびょ、ぴゃぴゅぴょ。"},
