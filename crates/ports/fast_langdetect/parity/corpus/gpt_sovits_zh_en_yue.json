  {"cat": "en_basic", "lang": "zh", "text": "Yes."},
  {"cat": "en_basic", "lang": "zh", "text": "Can you hear me? I can't hear you."},
  {"cat": "en_basic", "lang": "zh", "text": "It's John's book, and they're going to read it."},
  {"cat": "en_basic", "lang": "zh", "text": "We'll see what happens when we've finished."},

  {"cat": "en_heteronym", "lang": "zh", "text": "I read the book yesterday, and I will read it again."},
